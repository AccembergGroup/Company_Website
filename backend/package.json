{
  "name": "accemberg-backend",
  "version": "1.0.0",
  "description": "Accemberg REST API — Node.js + Express + PostgreSQL (Prisma)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "node prisma/seed.js",
    "test": "cross-env NODE_ENV=test jest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@sendgrid/mail": "^8.1.6",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2"
  }
}
