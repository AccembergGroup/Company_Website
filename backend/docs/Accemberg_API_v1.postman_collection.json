                  "  const body = pm.response.json();",
                  "  // After seeding, total should be 5 (4 verified + 1 unverified)",
                  "  pm.expect(body.total).to.be.at.least(body.total);",
                  "});"
                ],
                "type": "text/javascript"
              }
