{
  "info": {
    "_postman_id": "accemberg-api-v1",
    "name": "Accemberg Corporate API v1",
    "description": "Complete Postman collection for the Accemberg REST API.\n\n**Base URL (dev):** http://localhost:5000/api/v1\n\n**Auth:** Admin routes require the `x-api-key` header. Set the `adminApiKey` collection variable to your ADMIN_API_KEY value.\n\n**How to use:**\n1. Import this file into Postman.\n2. Set the `baseUrl` and `adminApiKey` collection variables.\n3. Run the Health Check first to confirm connectivity.\n4. Run the seed script (`npm run db:seed`) before testing catalogue endpoints.\n5. Use the Admin folder requests to manage data.\n6. Use the Public folder requests as the frontend would.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string",
      "description": "API base URL. Change to production URL when deploying."
    },
    {
      "key": "adminApiKey",
      "value": "REPLACE_WITH_YOUR_ADMIN_API_KEY",
      "type": "string",
      "description": "Value of the ADMIN_API_KEY environment variable from backend/.env"
    },
    {
      "key": "faqId",
      "value": "",
      "type": "string",
      "description": "Auto-populated by the Create FAQ request test script."
    },
    {
      "key": "testimonialId",
      "value": "",
      "type": "string",
      "description": "Auto-populated by the Create Testimonial request test script."
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string",
      "description": "Auto-populated by the Create Booking request test script."
    }
  ],
  "item": [
    {
      "name": "🟢 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies server and database connectivity. Returns 200 if healthy, 503 if database is unreachable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 503', function () {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Response has success field', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('success');",
                  "});",
                  "pm.test('Response has db status', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('db');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🛠️ Services",
      "item": [
        {
          "name": "List All Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["services"]
            },
            "description": "Returns all services ordered by `order` ascending. No authentication required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('total matches data length', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.total).to.equal(body.data.length);",
                  "});",
                  "pm.test('Each service has required fields', () => {",
                  "  pm.response.json().data.forEach(s => {",
                  "    pm.expect(s).to.have.property('id');",
                  "    pm.expect(s).to.have.property('title');",
                  "    pm.expect(s).to.have.property('order');",
                  "  });",
                  "});",
                  "pm.test('Services are ordered by order asc', () => {",
                  "  const orders = pm.response.json().data.map(s => s.order);",
                  "  const sorted = [...orders].sort((a, b) => a - b);",
                  "  pm.expect(orders).to.deep.equal(sorted);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
