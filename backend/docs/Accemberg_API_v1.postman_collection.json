            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Mehta\",\n  \"email\": \"priya.mehta@example.com\",\n  \"subject\": \"Partnership Enquiry\",\n  \"message\": \"Hi Accemberg team, I would like to explore a potential technology partnership for our fintech startup.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contact",
              "host": ["{{baseUrl}}"],
              "path": ["contact"]
            },
            "description": "Submits a contact form. Triggers internal notification email + auto-reply to the submitter. Rate-limited to 5 submissions per IP per hour."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has contactId', () => pm.expect(pm.response.json()).to.have.property('contactId'));",
                  "pm.test('Data contains submitted fields', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.name).to.equal('Priya Mehta');",
                  "  pm.expect(data).to.have.property('submittedAt');",
