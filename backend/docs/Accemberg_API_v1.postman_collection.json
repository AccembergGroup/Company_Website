              }
            }
          ]
        },
        {
          "name": "Submit Contact Form — Duplicate Email (5-min dedup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Mehta\",\n  \"email\": \"priya.mehta@example.com\",\n  \"subject\": \"Partnership Enquiry\",\n  \"message\": \"Sending again immediately after the first submission.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contact",
              "host": ["{{baseUrl}}"],
              "path": ["contact"]
            },
            "description": "Expected 429 Too Many Requests — run this immediately after 'Submit Contact Form — Valid' with the same email. The API blocks re-submissions within 5 minutes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 429', () => pm.response.to.have.status(429));",
                  "pm.test('success false', () => pm.expect(pm.response.json().success).to.be.false);",
                  "pm.test('Message mentions already received', () => {",
                  "  pm.expect(pm.response.json().message).to.match(/already received/i);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
