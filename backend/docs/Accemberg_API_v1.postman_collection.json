                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('success false', () => pm.expect(pm.response.json().success).to.be.false);",
                  "pm.test('Errors include email field', () => {",
                  "  pm.expect(pm.response.json().errors.some(e => e.field === 'email')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Submit Contact Form — Missing Required Fields",
          "request": {
            "method": "POST",
